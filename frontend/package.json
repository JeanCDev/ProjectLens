{
  "name": "projectlens-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-require-module vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-require-module vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@primeuix/themes": "^3.0.0",
    "@vueuse/core": "^13.0.0",
    "apexcharts": "^6.0.0",
    "axios": "^1.7.9",
    "pinia": "^3.0.1",
    "primevue": "^5.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}

FROM php:8.3-cli

# Extensões necessárias ao Laravel 13 (SQLite, não usamos MySQL)
RUN apt-get update -qq \
    && apt-get install -y -qq git unzip libicu-dev libcurl4-openssl-dev libzip-dev libsqlite3-dev libonig-dev libxml2-dev \
    && docker-php-ext-install pdo_sqlite mbstring xml curl zip bcmath intl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

EXPOSE 8000

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
